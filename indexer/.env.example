# Juno indexer (optional; unverified on Arc — see README.md). Copy to .env.
# Envio only passes ENVIO_-prefixed variables through.

# Arc testnet (chain 5042002). From deployments/arc-testnet.json: `launchpad`, `deployBlock`.
ENVIO_JUNO_TESTNET_LAUNCHPAD=
ENVIO_JUNO_TESTNET_START_BLOCK=
ENVIO_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# Blocks per eth_getLogs request (start, ceiling).
ENVIO_ARC_RPC_BLOCK_INTERVAL=2000
ENVIO_ARC_RPC_BLOCK_CEILING=9000

# Arc mainnet (chain 5042). Skipped until a mainnet launchpad exists.
ENVIO_JUNO_SKIP_MAINNET=true
ENVIO_JUNO_MAINNET_LAUNCHPAD=
ENVIO_JUNO_MAINNET_START_BLOCK=
ENVIO_ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
