# Juno on Arc — server environment. Copy to .env.local and fill in.
# Nothing here is a secret except where marked SECRET. .env.local is git-ignored.

# ─── Network ────────────────────────────────────────────────────────────────
# testnet (Arc testnet, chain 5042002 — the default) or mainnet (Arc, chain 5042).
NEXT_PUBLIC_ARC_NETWORK=testnet
# The server's RPC. Optional — defaults to the network's public endpoint
# (https://rpc.testnet.arc.io / https://rpc.mainnet.arc.io). May carry an API
# key: server-side only, never sent to the app. Local fork: http://127.0.0.1:8910
ARC_RPC_URL=
# The RPC the app is told to use for reads (GET /api/juno/config). Must not contain a key.
NEXT_PUBLIC_ARC_RPC_URL=
# Optional WebSocket for the live trade tape (/api/juno/live). Default: ARC_RPC_URL with ws://.
ARC_WS_URL=
# Arc mainnet RPC, used only to read Chainlink Data Feeds (registered on mainnet
# only) for tracker coins and the USDC/USD peg — read-only eth_calls, even when
# the app runs on testnet.
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
# Blocks per eth_getLogs for the trade log tail. Arc's public RPC answers spans
# of up to 10,000 blocks.
JUNO_LOG_RANGE=10000

# ─── Contracts ──────────────────────────────────────────────────────────────
# Addresses come from the deployment record scripts/deploy.sh writes:
# deployments/arc-<network>.json by default. Point this at another record to
# override — the local fork's is .fork/arc-fork.json.
JUNO_DEPLOYMENT_FILE=

# ─── Relayer (gasless buys, Gateway mints, faucet) ──────────────────────────
# SECRET. The one key this server holds. It pays the USDC gas for:
#  - gasless buys (EIP-3009 ReceiveWithAuthorization → buyWithAuthorization);
#  - Circle Gateway mints (GatewayMinter.gatewayMint, minted to the signer's recipient);
#  - the testnet faucet.
# It can't move anyone's USDC except as they signed. Fund it with a few USDC
# (gas on Arc is USDC; a relayed buy costs well under a cent). Leave empty to
# switch those three features off (the app falls back to signed transactions).
JUNO_RELAYER_PRIVATE_KEY=
# USDC sent per faucet request (testnet only, once per address per day).
FAUCET_AMOUNT_USDC=1

# ─── Circle (optional overrides) ────────────────────────────────────────────
# Gateway API (default https://gateway-api-testnet.circle.com / https://gateway-api.circle.com).
CIRCLE_GATEWAY_API_URL=
# CCTP attestation + fee service, Iris (default https://iris-api-sandbox.circle.com / https://iris-api.circle.com).
CIRCLE_IRIS_API_URL=

# ─── Indexer (optional) ─────────────────────────────────────────────────────
# The GraphQL endpoint of the Envio HyperIndex deployment in indexer/ (optional
# and unverified on Arc). Without it, history comes from receipts + the log tail.
ENVIO_GRAPHQL_URL=

# ─── Ethereum comparison (optional) ─────────────────────────────────────────
# GET /api/juno/tx/cost compares a trade's Arc fee with the same gas on Ethereum
# mainnet; tried before the public endpoints. May contain a key.
ETH_RPC_URL=

# ─── Storage ────────────────────────────────────────────────────────────────
# Postgres: pools, posts, trades, follows, plans, watchlist. SECRET.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Optional: a direct (unpooled) URL for migrations, pool size, and TLS ("disable" for a local server).
DATABASE_URL_UNPOOLED=
DATABASE_DIRECT_URL=
DATABASE_POOL_MAX=
DATABASE_SSL=
# Mongo: comments, likes, names. SECRET.
MONGODB_URI=
MONGODB_DB=juno
# IPFS pinning for media and token metadata. SECRET. Leave empty and the server keeps uploads
# in app-hosted demo storage under their content address: demo storage, not pinned
# to the network. Vercel uses the existing Mongo database; local runs default to JUNO_MEDIA_DIR.
# GET /api/juno/config reports `storage: "local"`; URLs are HTTPS, not unresolvable unpinned ipfs:// URIs.
PINATA_JWT=
# Where demo storage keeps files when PINATA_JWT is empty (default .juno/media).
JUNO_MEDIA_DIR=
# Persistent demo media in the existing MONGODB_DB (no new paid service).
# Automatically enabled on Vercel; set to mongo locally to rehearse serverless storage.
JUNO_MEDIA_BACKEND=
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
# Frames per second sampled for a video's blurred poster (upload route). Optional.
BLUR_KEYFRAME_FPS=

# ─── Deployment ─────────────────────────────────────────────────────────────
# The web app (juno-expo web build). When set, page requests to this server redirect there.
JUNO_APP_URL=
# The web app's origin, for the coin links the CLI scripts print.
NEXT_PUBLIC_SITE_URL=http://localhost:8912

# ─── CLI scripts (npm run juno:* / ccip:*) ──────────────────────────────────
# SECRET. A funded key for the scripts — or leave empty and they create one in
# .juno/ and print its address to fund (https://faucet.circle.com on testnet).
JUNO_SCRIPT_PRIVATE_KEY=
# Where the scripts and scripts/e2e-fork.mjs reach this API.
JUNO_API_URL=http://localhost:8911
# scripts/ccip-remote.ts (user-run): the remote chain's RPC and a funded key there. SECRET key.
BASE_SEPOLIA_RPC_URL=
ETHEREUM_SEPOLIA_RPC_URL=
CCIP_REMOTE_PRIVATE_KEY=

# ─── Contract deploy (scripts/deploy.sh testnet|mainnet; read by contracts/script/Deploy.s.sol) ──
# The deployer key is NOT set here: deploy.sh reads DEPLOYER_PRIVATE_KEY from DEPLOYER_ENV
# (default ../.deployer/deployer.env). Circle's Arc Foundry binaries: FORGE, CAST, ARC_ANVIL.
# JUNO_OWNER=                 # final owner (a Safe on mainnet); must acceptOwnership()
# JUNO_PROTOCOL_SHARE_BPS=2000
# JUNO_MAX_RAISE_USDC=100000  # per-curve raise cap (hard limit 10M)
# UNISWAP_V2_FACTORY=         # reuse an existing v2 factory instead of deploying Uniswap's published one
# JUNO_REGISTER_FEEDS=        # default: true on mainnet (Chainlink feeds), false on testnet
# JUNO_CONFIRM_MAINNET=yes    # required for a mainnet broadcast
# ARC_TESTNET_RPC_URL= / ARC_MAINNET_RPC_URL=
