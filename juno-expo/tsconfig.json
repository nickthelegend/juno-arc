{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true
  },
  // Expo's base list, restated because an `exclude` here replaces it, plus
  // `dist/` (and `dist-fork/`, a local export): the base allows JS, so after `npm run export:web` tsc read the
  // 14 MB web bundle and overflowed its stack.
  "exclude": ["node_modules", "babel.config.js", "metro.config.js", "jest.config.js", "android", "ios", "dist", "dist-fork", "dist-local"]
}
