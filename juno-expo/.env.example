# Juno on Arc — the Expo app (web build: `npm run export:web`).
# Copy to .env.local (git-ignored) to override.

# The Juno API (the Next.js server at the repo root). Defaults to http://localhost:8911
# in development; set it for any deployed web build.
EXPO_PUBLIC_API_URL=http://localhost:8911

# The public URL the web build is served from, for og:url in the exported index.html. Optional.
EXPO_PUBLIC_APP_URL=

# A share image for link previews (og:image). Optional.
EXPO_PUBLIC_OG_IMAGE=
